{
  "name": "webcode-monorepo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:extension": "pnpm --filter gateway-vscode run test:extension",
    "test:e2e:minimal": "pnpm --filter @webcode/evals run e2e:minimal",
    "test:e2e:command-risk": "pnpm --filter @webcode/evals run e2e:command-risk",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release/build-release.ps1",
    "release:sh": "bash scripts/release/build-release.sh",
    "bridge:sync": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release/update-manual-bridge.ps1",
    "eval:scenarios": "pnpm --filter @webcode/evals run scenarios",
    "eval:deepseek": "pnpm --filter @webcode/evals run live:deepseek",
    "qa:manual": "pnpm --filter @webcode/evals run qa:manual",
    "qa:start": "pnpm --filter @webcode/evals run qa:start",
    "qa:pw": "pnpm --filter @webcode/evals run qa:pw",
    "qa:ctl": "pnpm --filter @webcode/evals run qa:ctl",
    "qa:status": "pnpm --filter @webcode/evals run qa:status",
    "qa:stop": "pnpm --filter @webcode/evals run qa:stop",
    "lint": "eslint .",
    "audit:shipped": "node scripts/audit-shipped-deps.mjs",
    "audit:shipped:strict": "node scripts/audit-shipped-deps.mjs --require-bundle",
    "check:contrast": "node scripts/check-contrast.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint": "^9.21.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.72.0"
  },
  "pnpm": {
    "overrides": {
      "qs": ">=6.16.0",
      "body-parser": ">=1.20.9 <2.0.0",
      "proxy-addr": ">=2.0.8 <3.0.0",
      "fast-uri": ">=3.1.8 <4.0.0",
      "hono": ">=4.13.11 <5.0.0",
      "@hono/node-server": ">=1.19.15 <2.0.0",
      "ip-address": ">=10.7.4 <11.0.0",
      "zod": ">=4.6.7 <5.0.0"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "keytar"
    ]
  },
  "lint-staged": {
    "*.{ts,mjs}": "eslint --fix"
  },
  "packageManager": "pnpm@10.25.0+sha512.5e82639027af37cf832061bcc6d639c219634488e0f2baebe785028a793de7b525ffcd3f7ff574f5e9860654e098fe852ba8ac5dd5cefe1767d23a020a92f501"
}
